HYDRA_DB_API_KEY=
HYDRADB_DATABASE_ID=
HYDRADB_COLLECTION_ID=recoil
HYDRADB_API_URL=https://api.hydradb.com
HYDRADB_INGEST_BATCH_SIZE=8
RECOIL_PORT=8787
RECOIL_HOST=127.0.0.1
RECOIL_API_URL=http://127.0.0.1:8787
# Production mode serves the built frontend and API from one origin.
RECOIL_SERVE_STATIC=0
RECOIL_STATIC_DIR=dist
# Public-demo safeguards. Rate limiting is per forwarded client address.
RECOIL_MAX_CONCURRENT_INVESTIGATIONS=3
RECOIL_SCAN_RATE_LIMIT=8
RECOIL_SCAN_RATE_WINDOW_MS=900000
RECOIL_MAX_REQUEST_BYTES=65536
RECOIL_ALLOWED_ORIGIN=*
# Time allowed for active scans to complete before the final workspace flush.
RECOIL_SHUTDOWN_DRAIN_MS=25000
# Single-tenant workspace state. Use a mounted persistent path in production.
RECOIL_WORKSPACE_FILE=.recoil-data/workspace.json
# Optional durable workspace mirror for App Runner. The service instance role
# needs s3:GetObject and s3:PutObject for this object.
RECOIL_WORKSPACE_S3_BUCKET=
RECOIL_WORKSPACE_S3_KEY=recoil/workspace.json
# Production refuses to start when a configured S3 workspace cannot be read.
# Set this only for an intentional local-snapshot recovery session.
RECOIL_WORKSPACE_ALLOW_LOCAL_FALLBACK=0
AWS_REGION=
# Disabled by default. Values below 60000 are clamped to one minute.
RECOIL_WATCH_INTERVAL_MS=0
# Optional generic JSON webhook for new or changed reachable exposures.
RECOIL_NOTIFICATION_WEBHOOK_URL=
OPENAI_API_KEY=
RECOIL_AGENT_MODEL=gpt-5
RECOIL_ADVISORY_AGENT=off
RECOIL_ADVISORY_MODEL=
GITHUB_TOKEN=
RECOIL_CACHE_DIR=.recoil-cache
RECOIL_NETWORK_RETRIES=3
HYDRADB_REQUEST_TIMEOUT_MS=15000
# Remote repository evidence limits. Recoil records when any limit truncates
# collection instead of presenting a bounded scan as complete.
RECOIL_SOURCE_FILE_LIMIT=48
RECOIL_CARGO_MANIFEST_LIMIT=120
RECOIL_DISCOVERY_PACKAGE_LIMIT=2000
RECOIL_DISCOVERY_ADVISORY_LIMIT=50
RECOIL_OSV_BATCH_SIZE=100
HYDRADB_INDEX_WAIT_MS=60000
HYDRADB_INDEX_POLL_MS=500
HYDRADB_RECALL_WAIT_MS=15000
HYDRADB_RECALL_POLL_MS=1500
# Temporal memories can become searchable after graph memories. Recoil polls
# the focused reachability query for this bounded window before reporting an
# empty temporal read.
HYDRADB_TEMPORAL_RECALL_WAIT_MS=30000
RECOIL_HYDRA_PERSIST_PARTIAL=0
RECOIL_SMOKE_REQUIRE_CONTRAST=0
RECOIL_SMOKE_REQUIRE_HYDRA=0
