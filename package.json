{
  "name": "recoil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env scripts/start.js",
    "serve": "RECOIL_SERVE_STATIC=1 RECOIL_HOST=0.0.0.0 node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "build:tui": "node scripts/verify-tui.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "cli": "node --env-file-if-exists=.env cli/recoil.js",
    "mcp": "node --env-file-if-exists=.env mcp/server.js",
    "test": "node --test --import ./scripts/test-cache.mjs test/*.test.js",
    "benchmark": "node scripts/evidence-benchmark.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "verify": "node scripts/verify.js",
    "smoke:real": "node --env-file-if-exists=.env scripts/smoke-real.mjs",
    "smoke:recording": "node --env-file-if-exists=.env scripts/smoke-real.mjs --strict",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "tui": "bun run tui/index.tsx",
    "server": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentui/core": "0.5.3",
    "@opentui/react": "0.5.3",
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
